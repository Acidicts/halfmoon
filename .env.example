# Copy to .env and fill in values (never commit .env)
# cp .env.example .env

# Hack Club OAuth (required for sign-in)
# Register at https://auth.hackclub.com and set the callback to <APP_URL>/auth/hackclub/callback
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Public origin of this app (used as the OAuth redirect_uri origin)
# e.g. http://localhost:3000 in dev, https://halfmoon.hackclub.com in production
APP_URL=http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=granite_development

# Cache / background
REDIS_URL=redis://localhost:6379/1

# Server
PORT=3000
RAILS_MAX_THREADS=5

# Production only
# RAILS_LOG_LEVEL=info

SECRET_KEY_BASE=

ENCRYPTION_PRIMARY_KEY=
ENCRYPTION_DETERMINISTIC_KEY=
ENCRYPTION_KEY_DERIVATION_SALT=

# Slack Bot
SLACK_CHANNEL_ID=
SLACK_OAUTH_TOKEN=