<%= stylesheet_link_tag "pages/home/rsvp" %>

<div class="banner">
    <div class="starry-sky" id="sky">
        <div class="star-layer small"></div>
        <div class="star-layer medium"></div>
        <div class="star-layer large"></div>
    </div>
    <div class="content matcha">
        <div class="rsvp-hero">
            <div class="moon-icon moon-full"></div>
            <h1>Help us rebuild the moon</h1>
            <p class="rsvp-hero__sub">
                RSVP now so we can make the ysws quicker
            </p>

            <% if @rsvped %>
                <p class="rsvp-page__status rsvp-page__status--done">
                    Thanks for your support! See you on the moon.
                </p>
                <%= link_to 'View confirmation', rsvp_thanks_path, class: 'rsvp-page__cta rsvp-page__cta--link' %>
            <% else %>
                <% if current_user %>
                    <p class="rsvp-page__status">Signed in — you're one click away.</p>
                <% else %>
                    <p class="rsvp-page__status">You'll sign in with Hack Club when you hit RSVP.</p>
                <% end %>
                <%= button_to 'RSVP here', rsvp_path, method: :post, class: 'rsvp-page__cta' %>
            <% end %>
        </div>
    </div>
</div>

<div class="rsvp-info matcha">
    <div class="rsvp-info__step">
        <div class="moon-icon moon-empty"></div>
        <h2>Make a project</h2>
        <p>Build something with a language you and your friend know.</p>
    </div>
    <div class="rsvp-info__step">
        <div class="moon-icon moon-half"></div>
        <h2>Swap it</h2>
        <p>Ship it, swap with your friend, and build on top of theirs.</p>
    </div>
    <div class="rsvp-info__step">
        <div class="moon-icon moon-full"></div>
        <h2>Rebuild the moon</h2>
        <p>Ship your final project and help rebuild the moon.</p>
    </div>
</div>

<script>
  const sky = document.getElementById('sky');

  // Stars per 100,000 px² of screen area for each layer
  const DENSITY = { small: 60, medium: 18, large: 5 };

  function randomStars(count, width, height) {
    const shadows = [];
    for (let i = 0; i < count; i++) {
      const x = Math.floor(Math.random() * width);
      const y = Math.floor(Math.random() * height);
      const alpha = (0.5 + Math.random() * 0.5).toFixed(2);
      // Slight colour variation: mostly white, some bluish, some warm
      const tint = Math.random();
      const rgb = tint < 0.7 ? '255,255,255' : tint < 0.85 ? '190,210,255' : '255,235,200';
      shadows.push(`${x}px ${y}px rgba(${rgb},${alpha})`);
    }
    return shadows.join(',');
  }

  function scatter(container) {
    if (!container) return;
    const w = container.clientWidth;
    const h = container.clientHeight;
    if (!w || !h) return;
    const area = (w * h) / 100000;

    for (const [name, density] of Object.entries(DENSITY)) {
      const layer = container.querySelector('.star-layer.' + name);
      if (layer) layer.style.boxShadow = randomStars(Math.round(area * density), w, h);
    }
  }

  function render() {
    scatter(sky);
    scatter(document.querySelector('#starmap .starmap-sky'));
  }

  render();

  // Re-scatter when the window size changes (debounced)
  let timer;
  window.addEventListener('resize', () => {
    clearTimeout(timer);
    timer = setTimeout(render, 150);
  });
</script>
